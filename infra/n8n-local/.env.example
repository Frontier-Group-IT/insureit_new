# Copy to .env and fill locally. Never commit the resulting .env file.
# Pin an EXACT version, ideally matching n8n Cloud (Settings > About).
N8N_VERSION=REPLACE_WITH_TESTED_EXACT_VERSION
POSTGRES_USER=n8n
POSTGRES_DB=n8n
# Generate a fresh high-entropy secret; never reuse your n8n Cloud secrets.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
N8N_ENCRYPTION_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
