# Copy to .env on Windows. Never commit .env or credentials.
# Public build-time values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private runtime credentials (configure only on the Windows host)
SUPABASE_SERVICE_ROLE_KEY=
INSUREIT_N8N_OCR_WEBHOOK_URL=https://n8n.nishant.uk/webhook/insureit-policy-intake-icici-v1
INSUREIT_N8N_OCR_HEADER_SECRET=
INSUREIT_N8N_OCR_MODE=
INSUREIT_N8N_WORKBENCH_PRIMARY=
# Include other required canonical booking/OTP configuration from existing
# production backend; do not assume this sample is complete.

# Keep disabled until authenticated negative/positive tests and signoff.
INSUREIT_AI_STUDIO_BACKEND_ENABLED=false
