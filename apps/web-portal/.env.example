NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_PORTAL_URL=https://insureit-drab.vercel.app

# Server-only secret used to sign short-lived login CAPTCHA challenges.
# Use at least 32 random characters. Never prefix this with NEXT_PUBLIC_.
LOGIN_CAPTCHA_SECRET=

# Private server-to-server integration gateway. Never prefix these with NEXT_PUBLIC_.
# Keep the real relay secret only in the target server/Vercel environment.
ICALL_GATEWAY_URL=https://insureit.duckdns.org
ICALL_GATEWAY_SECRET=

# Production launch scope. Set this explicitly in Vercel Production only when
# the first release must expose only the Intermediary workspace.
# Leave blank in development/preview environments to retain the full portal.
NEXT_PUBLIC_INSUREIT_LAUNCH_SCOPE=intermediary

# Server-only Google Document AI policy OCR configuration.
# Vercel supplies VERCEL_OIDC_TOKEN automatically when OIDC federation is enabled.
GOOGLE_CLOUD_PROJECT_ID=insureit-policy-ocr-production
GOOGLE_CLOUD_PROJECT_NUMBER=560319705586
GOOGLE_WORKLOAD_IDENTITY_POOL_ID=vercel-insureit
GOOGLE_WORKLOAD_IDENTITY_PROVIDER_ID=vercel
GOOGLE_SERVICE_ACCOUNT_EMAIL=insureit-ocr-web@insureit-policy-ocr-production.iam.gserviceaccount.com
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=84d0facf88efc0d7

# Optional local-only short-lived OIDC subject token for integration testing.
# Never commit a real token and never expose this variable to the browser.
GOOGLE_WORKLOAD_IDENTITY_SUBJECT_TOKEN=

# INSUREIT n8n policy PDF extraction (server-side runtime; Cloudflare Worker).
# The authenticated n8n workflow is published but this integration defaults OFF.
# Insert the SAME n8n webhook Header Auth value only into Cloudflare's Secret type.
# IMPORTANT: Never store the real value in this file or NEXT_PUBLIC_*.
INSUREIT_N8N_OCR_WEBHOOK_URL=https://insureit.app.n8n.cloud/webhook/insureit-policy-intake-icici-v1
INSUREIT_N8N_OCR_HEADER_SECRET=
INSUREIT_N8N_OCR_MODE=off
INSUREIT_N8N_OCR_ALLOWED_INTAKE_IDS=
# In required mode, true routes recognized ICICI Lombard Product 3005 native PDFs
# through the signed Storage n8n fetch without Google OCR. Other insurers keep
# legacy OCR until trained. Does NOT mean the PDF is automatically bookable.
INSUREIT_N8N_OCR_AUTO_ICICI_3005=false
# NEVER enable before all insurer layouts are supported or manual-only handling
# is expressly accepted for untrained Motor policies.
INSUREIT_N8N_OCR_ALL_MOTOR=false
INSUREIT_N8N_OCR_ALLOW_REVIEW_APPLY=false
