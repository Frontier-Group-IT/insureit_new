NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_PORTAL_URL=https://insureit-drab.vercel.app

# Production launch scope. Set this explicitly in Vercel Production only when
# the first release must expose only the Intermediary workspace.
# Leave blank in development/preview environments to retain the full portal.
NEXT_PUBLIC_INSUREIT_LAUNCH_SCOPE=intermediary

# Server-only Google Document AI policy OCR configuration.
# Vercel supplies VERCEL_OIDC_TOKEN automatically when OIDC federation is enabled.
GOOGLE_CLOUD_PROJECT_ID=insureit-policy-ocr-production
GOOGLE_CLOUD_PROJECT_NUMBER=560319705586
GOOGLE_WORKLOAD_IDENTITY_POOL_ID=vercel-insureit
GOOGLE_WORKLOAD_IDENTITY_PROVIDER_ID=vercel
GOOGLE_SERVICE_ACCOUNT_EMAIL=insureit-ocr-web@insureit-policy-ocr-production.iam.gserviceaccount.com
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=84d0facf88efc0d7

# Optional local-only short-lived OIDC subject token for integration testing.
# Never commit a real token and never expose this variable to the browser.
GOOGLE_WORKLOAD_IDENTITY_SUBJECT_TOKEN=

# Server-only INSUREIT assistant model configuration. The endpoint must expose
# an approved OpenAI-compatible chat/tool API. Never prefix these with
# NEXT_PUBLIC_ and never commit a real key.
ASSISTANT_API_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
