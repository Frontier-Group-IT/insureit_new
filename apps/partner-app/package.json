{
  "name": "@insureit/partner-app",
  "private": true,
  "version": "0.2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:phase5": "node scripts/verify-phase5-contracts.mjs",
    "verify:visual": "node scripts/verify-visual-system-completion.mjs",
    "verify:pre-apk": "node scripts/verify-pre-apk-freeze.mjs",
    "verify:phase6": "node scripts/verify-phase6-native-foundation.mjs",
    "verify:uat": "node scripts/verify-pre-apk-uat.mjs",
    "build:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.49.8",
    "expo": "^54.0.35",
    "expo-document-picker": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.9",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
