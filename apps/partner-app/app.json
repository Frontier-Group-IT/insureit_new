{
  "expo": {
    "name": "INSUREIT Partner",
    "slug": "insureit-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "insureit-partner",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.insureit.partner",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.insureit.partner",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "antnish"
  }
}
