{
  "expo": {
    "name": "INSUREIT Partner",
    "slug": "insureit",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "insureit-partner",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.insureit.partner",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 2,
      "icon": "./assets/partner-app-icon.jpg"
    },
    "ios": {
      "bundleIdentifier": "com.insureit.partner",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2",
      "icon": "./assets/partner-app-icon.jpg"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#3156B8",
          "defaultChannel": "partner-updates"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock INSUREIT Partner on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "insureitapp",
    "updates": {
      "url": "https://u.expo.dev/8ade82c1-4c96-4f09-b90b-802270fb406d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ade82c1-4c96-4f09-b90b-802270fb406d"
      }
    },
    "icon": "./assets/partner-app-icon.jpg"
  }
}
