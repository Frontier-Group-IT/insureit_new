{
  "manifest_version": 3,
  "name": "IIB POS PAN Checker - N.M.",
  "version": "1.0.1",
  "description": "Checks queued InsureIt POSP/MISP PAN numbers in the authorised IIB POS portal session.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://pos.iib.gov.in/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "N.M. PAN Checker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://pos.iib.gov.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}