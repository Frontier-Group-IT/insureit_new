{
  "name": "insureit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web-portal",
    "apps/mobile-app",
    "apps/partner-app",
    "packages/*"
  ],
  "overrides": {
    "expo-constants": "18.0.13",
    "expo-font": "14.0.12",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0"
  },
  "scripts": {
    "dev": "npm --workspace apps/web-portal run dev",
    "build": "npm --workspace apps/web-portal run build",
    "lint": "npm --workspace apps/web-portal run lint",
    "typecheck": "npm --workspace apps/web-portal run typecheck",
    "dev:web": "npm --workspace apps/web-portal run dev",
    "build:web": "npm --workspace apps/web-portal run build",
    "lint:web": "npm --workspace apps/web-portal run lint",
    "typecheck:web": "npm --workspace apps/web-portal run typecheck",
    "dev:mobile": "npm --workspace apps/mobile-app run dev",
    "dev:mobile:web": "npm --workspace apps/mobile-app run web",
    "build:mobile:web": "npm --workspace apps/mobile-app run build:web",
    "lint:mobile": "npm --workspace apps/mobile-app run lint",
    "typecheck:mobile": "npm --workspace apps/mobile-app run typecheck",
    "dev:partner": "npm --workspace apps/partner-app run start",
    "dev:partner:web": "npm --workspace apps/partner-app run web",
    "lint:partner": "npm --workspace apps/partner-app run lint",
    "typecheck:partner": "npm --workspace apps/partner-app run typecheck",
    "build:partner:web": "npm --workspace apps/partner-app run build:web"
  },
  "dependencies": {
    "expo-font": "14.0.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "supabase": "^2.106.0"
  }
}
